{# @KilikTable/_stats.html.twig #}
{% if tableRenderStats is defined %}
    <span class="kt-stats">
        {% if table.filteredRows == 0 %}
            {{ "kiliktable.no_result"|trans }}
        {% else %}
            <strong>{{ table.firstRow|format_number }} – {{ table.lastRow|format_number }}</strong>
            {{ "kiliktable.stats_of"|trans }}
            <strong>{{ table.filteredRows|format_number }}</strong>
            {{ "kiliktable.stats_results"|trans({"%count%": table.filteredRows}) }}
        {% endif %}
        {% if table.filteredRows != table.totalRows and table.totalRows > 0 %}
            · {{ "kiliktable.stats_filtered_from"|trans({"%count%": table.filteredRows, "%totalRows%": table.totalRows|format_number}) }}
        {% endif %}
    </span>
{% endif %}
